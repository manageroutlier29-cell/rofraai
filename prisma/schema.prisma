generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                @id @default(uuid())
  email             String                @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              UserRole              @default(WORKER)
  status            UserStatus            @default(PENDING)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  assignments       Assignment[]
  clientProfile     ClientProfile?
  earnings          Earning[]
  paymentAccounts   PaymentAccount[]
  projects          Project[]
  reviews           Review[]
  submissions       Submission[]
  tasks             Task[]
  transactions      Transaction[]
  withdrawals       Withdrawal[]
  marketplaceAccess WorkerAccess?
  workerProfile     WorkerProfile?
  qualifications    WorkerQualification[]
  wallet            WorkerWallet?

  @@index([role])
  @@index([status])
}

model WorkerWallet {
  id               String   @id @default(uuid())
  workerId         String   @unique
  availableBalance Decimal  @default(0) @db.Decimal(12, 2)
  pendingBalance   Decimal  @default(0) @db.Decimal(12, 2)
  paidBalance      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  worker           User     @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model WorkerAccess {
  id                  String    @id @default(uuid())
  workerId            String    @unique
  freeTaskLimit       Int       @default(3)
  tasksClaimed        Int       @default(0)
  tasksCompleted      Int       @default(0)
  isUnlocked          Boolean   @default(false)
  unlockFee           Decimal   @default(5.00) @db.Decimal(12, 2)
  unlockedAt          DateTime?
  unlockTransactionId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  worker              User      @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([isUnlocked])
}

model WorkerProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  bio        String?
  skills     String?
  country    String?
  experience String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentAccount {
  id                String               @id @default(uuid())
  workerId          String
  type              PaymentAccountType
  status            PaymentAccountStatus @default(ACTIVE)
  accountName       String?
  phoneNumber       String?
  bankName          String?
  accountNumber     String?
  bankCode          String?
  country           String               @default("KE")
  currency          String               @default("KES")
  provider          String?
  providerReference String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  isDefault         Boolean              @default(false)
  worker            User                 @relation(fields: [workerId], references: [id], onDelete: Cascade)
  withdrawals       Withdrawal[]

  @@index([workerId])
  @@index([type])
  @@index([status])
}

model ClientProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String?
  website     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String        @id @default(uuid())
  clientId    String
  title       String
  description String
  category    String
  budget      Decimal       @db.Decimal(12, 2)
  status      ProjectStatus @default(DRAFT)
  deadline    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  client      User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([clientId])
  @@index([status])
  @@index([category])
}

model Task {
  id          String       @id @default(uuid())
  projectId   String
  title       String
  description String
  category    String
  reward      Decimal      @db.Decimal(12, 2)
  status      TaskStatus   @default(DRAFT)
  deadline    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workerId    String?
  assignments Assignment[]
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker      User?        @relation(fields: [workerId], references: [id])

  @@index([projectId])
  @@index([workerId])
  @@index([status])
  @@index([category])
}

model Assignment {
  id          String           @id @default(uuid())
  taskId      String
  workerId    String
  status      AssignmentStatus @default(PENDING)
  assignedAt  DateTime         @default(now())
  acceptedAt  DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker      User             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  earning     Earning?
  submissions Submission[]

  @@unique([taskId, workerId])
  @@index([taskId])
  @@index([workerId])
  @@index([status])
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  workerId     String
  content      String?
  status       SubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  reviews      Review[]
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  worker       User             @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([workerId])
  @@index([status])
}

model Review {
  id           String       @id @default(uuid())
  submissionId String
  reviewerId   String
  status       ReviewStatus @default(PENDING)
  score        Int?
  feedback     String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reviewer     User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([reviewerId])
  @@index([status])
}

model WorkerQualification {
  id          String              @id @default(uuid())
  workerId    String
  name        String
  category    String
  description String?
  status      QualificationStatus @default(NOT_STARTED)
  score       Int?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  worker      User                @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([category])
  @@index([status])
}

model Earning {
  id           String        @id @default(uuid())
  workerId     String
  assignmentId String        @unique
  amount       Decimal       @db.Decimal(12, 2)
  status       EarningStatus @default(PENDING)
  description  String?
  availableAt  DateTime?
  paidAt       DateTime?
  reversedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assignment   Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  worker       User          @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([status])
}

model Withdrawal {
  id                  String           @id @default(uuid())
  workerId            String
  amount              Decimal          @db.Decimal(12, 2)
  status              WithdrawalStatus @default(PENDING)
  paymentMethod       String?
  paymentReference    String?
  failureReason       String?
  requestedAt         DateTime         @default(now())
  processedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  exchangeRate        Decimal?         @db.Decimal(18, 6)
  paymentAccountId    String?
  payoutAmount        Decimal?         @db.Decimal(12, 2)
  payoutCurrency      String?
  payoutAccountName   String?
  payoutAccountNumber String?
  payoutBankCode      String?
  payoutBankName      String?
  payoutCountry       String?
  payoutCurrencyCode  String?
  payoutPhoneNumber   String?
  paymentAccount      PaymentAccount?  @relation(fields: [paymentAccountId], references: [id])
  worker              User             @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([status])
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String?
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("USD")
  reference   String?
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User?             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([reference])
  @@index([createdAt])
}

enum UserRole {
  WORKER
  CLIENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ProjectStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  DRAFT
  AVAILABLE
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  REVIEW
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  REJECTED
  CANCELLED
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REVISION_REQUIRED
  REJECTED
}

enum EarningStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum QualificationStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  FAILED
  EXPIRED
}

enum TransactionType {
  CLIENT_PAYMENT
  TASK_EARNING
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  REFUND
  PLATFORM_FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  REFUNDED
}

enum PaymentAccountType {
  MPESA
  BANK
}

enum PaymentAccountStatus {
  ACTIVE
  INACTIVE
}
